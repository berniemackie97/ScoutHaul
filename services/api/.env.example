# ── ScoutHaul API Environment ─────────────────────────────────────
#
# Copy to .env for local development.
# All values below are dev defaults — safe to use as-is locally.
#
# For staging/production, set these via your cloud host's secret manager
# (Railway variables, Fly.io secrets, Azure App Configuration, AWS SSM, etc.)

# ── Runtime ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5080

# ── Database ──────────────────────────────────────────────────────
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=scouthaul;Username=scouthaul;Password=scouthaul
Database__ApplyMigrationsOnStartup=true

# ── Auth (Development only — StubAuth) ────────────────────────────
# When StubAuth values are present, dev requests can fall back to headers.
# A valid ScoutHaul bearer token still takes precedence. Remove for production.
StubAuth__DefaultOrganizationId=9d3c0c44-218b-49d9-90bf-07b748610001
StubAuth__DefaultUserId=9d3c0c44-218b-49d9-90bf-07b748610002

# ── Auth (Supabase Auth) ──────────────────────────────────────────
# The API validates Supabase access tokens and maps them to local
# ScoutHaul users, organizations, teams, roles, and permissions.
# Authentication__Supabase__Url=https://your-project.supabase.co
# Authentication__Supabase__Audience=authenticated
# Server-only. Required for owner/member invite emails; never expose in mobile.
# Authentication__Supabase__ServiceRoleKey=your-service-role-key
# Authentication__Supabase__InviteRedirectUrl=scouthaul://account
# Optional fallback for legacy HS256 Supabase projects:
# Authentication__Supabase__JwtSecret=your-supabase-jwt-secret

# ── File Storage ─────────────────────────────────────────────────
# Inventory photos are served from API wwwroot/uploads for closed beta.
# Mount/persist the API wwwroot directory in staging/prod, or replace this
# service with Supabase Storage/S3 before broad public release.
Storage__InventoryPhotos__MaxBytes=8000000

# ── Barcode product identity providers ───────────────────────────
# The scan lookup chain tries configured providers first and falls back to
# UPCitemdb, which has public/free trial behavior but limited reliability.
# EanDb__Jwt=your-ean-db-jwt
# BarcodeLookup__ApiKey=your-barcode-lookup-api-key
# UpcDev__Enabled=false
# UpcDev__ApiKey=your-upc-dev-api-key

# ── Marketplace pricing providers ────────────────────────────────
# All provider keys are optional. Configure one or more; results are merged,
# deduplicated, and saved to MarketObservations for future analysis.
MarketplaceLookup__PersistLookupResults=true
MarketplaceLookup__MaxListingsToPersist=25

# PriceCharting is best for video games, cards, comics, and collectibles.
# PriceCharting__Token=your-pricecharting-token
# PriceCharting__LookupAllBarcodes=false

# Keepa maps UPC/EAN/ISBN to Amazon catalog pricing when available.
# Keepa__ApiKey=your-keepa-api-key
# Keepa__DomainId=1
# Keepa__StatsDays=90

# SerpApi Google Shopping is the broad fallback for retail/shopping signals.
# SerpApi__ApiKey=your-serpapi-api-key
# SerpApi__Gl=us
# SerpApi__Hl=en
# SerpApi__Limit=20

# eBay Browse API remains supported when developer credentials are available.
# Ebay__ClientId=your-client-id
# Ebay__ClientSecret=your-client-secret
# Ebay__UseSandbox=false

# ── CORS (Production) ────────────────────────────────────────────
# Cors__AllowedOrigins__0=https://app.scouthaul.com
# Cors__AllowedOrigins__1=https://scouthaul.com

# ── Rate Limiting ─────────────────────────────────────────────────
# RateLimiting__PermitLimit=100
# RateLimiting__WindowSeconds=60

# ── Google Cloud Vision (Visual Product Identification) ─────────
# Enables photo-based product identification in the scanner and inventory.
# 1,000 free requests/month, then $3.50/1000. Restrict key to Cloud Vision API only.
# GoogleCloudVision__ApiKey=your-api-key
