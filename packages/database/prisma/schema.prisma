generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AUTH & USERS
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  repairJobs    RepairJob[]
  consignments  ConsignmentSubmission[]
  pawnTransactions PawnTransaction[]
  referralsSent    Referral[] @relation("ReferralSender")
  referralsReceived Referral[] @relation("ReferralReceiver")
  cart          Cart?
  notifications Notification[]

  @@index([clerkId])
  @@index([email])
}

enum UserRole {
  CUSTOMER
  EMPLOYEE
  TECHNICIAN
  MANAGER
  ADMIN
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  zipCode   String
  country   String   @default("US")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ──────────────────────────────────────────────
// PRODUCTS & INVENTORY
// ──────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  name            String
  slug            String          @unique
  description     String
  shortDescription String?
  condition       ItemCondition
  conditionNotes  String?
  categoryId      String
  costPrice       Decimal         @db.Decimal(10, 2)
  listPrice       Decimal         @db.Decimal(10, 2)
  compareAtPrice  Decimal?        @db.Decimal(10, 2)
  status          ProductStatus   @default(DRAFT)
  sourceType      SourceType
  sourceDetails   String?
  weight          Decimal?        @db.Decimal(8, 2)
  width           Decimal?        @db.Decimal(8, 2)
  height          Decimal?        @db.Decimal(8, 2)
  depth           Decimal?        @db.Decimal(8, 2)
  brand           String?
  model           String?
  year            Int?
  tags            String[]
  isFeatured      Boolean         @default(false)
  isShippable     Boolean         @default(true)
  localPickupOnly Boolean         @default(false)
  quantity        Int             @default(1)
  viewCount       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  soldAt          DateTime?

  category        Category          @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  channelListings ChannelListing[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  cartItems       CartItem[]
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([sku])
  @@index([sourceType])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
  REPAIR_NEEDED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  FOR_PARTS
}

enum SourceType {
  THRIFT_STORE
  ESTATE_SALE
  LIQUIDATION_PALLET
  CONSIGNMENT
  PAWN
  WHOLESALE
  PRIVATE_PURCHASE
  DONATION
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ──────────────────────────────────────────────
// MULTI-CHANNEL LISTINGS
// ──────────────────────────────────────────────

model ChannelListing {
  id           String        @id @default(cuid())
  productId    String
  channel      SalesChannel
  externalId   String?
  externalUrl  String?
  listedPrice  Decimal       @db.Decimal(10, 2)
  status       ListingStatus @default(DRAFT)
  listedAt     DateTime?
  lastSyncedAt DateTime?
  syncErrors   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([channel])
  @@index([status])
}

enum SalesChannel {
  WEBSITE
  EBAY
  FACEBOOK_MARKETPLACE
  LOCAL_RETAIL
  WHOLESALE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
  ERROR
}

// ──────────────────────────────────────────────
// SHOPPING CART
// ──────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

// ──────────────────────────────────────────────
// ORDERS & FULFILLMENT
// ──────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String
  shippingAddressId String?
  channel           SalesChannel  @default(WEBSITE)
  status            OrderStatus   @default(PENDING)
  subtotal          Decimal       @db.Decimal(10, 2)
  taxAmount         Decimal       @db.Decimal(10, 2) @default(0)
  shippingAmount    Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount    Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount       Decimal       @db.Decimal(10, 2)
  stripePaymentId   String?
  stripeSessionId   String?
  fulfillmentMethod FulfillmentMethod @default(SHIP)
  trackingNumber    String?
  trackingCarrier   String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User       @relation(fields: [userId], references: [id])
  shippingAddress Address?   @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum FulfillmentMethod {
  SHIP
  LOCAL_PICKUP
  DELIVERY
}

// ──────────────────────────────────────────────
// REPAIR SERVICES
// ──────────────────────────────────────────────

model RepairJob {
  id              String       @id @default(cuid())
  jobNumber       String       @unique
  userId          String
  itemDescription String
  itemBrand       String?
  itemModel       String?
  issueDescription String
  diagnosis       String?
  estimatedCost   Decimal?     @db.Decimal(10, 2)
  finalCost       Decimal?     @db.Decimal(10, 2)
  status          RepairStatus @default(SUBMITTED)
  priority        RepairPriority @default(NORMAL)
  technicianNotes String?
  partsUsed       String?
  laborHours      Decimal?     @db.Decimal(5, 2)
  imageUrls       String[]
  receivedAt      DateTime?
  diagnosedAt     DateTime?
  approvedAt      DateTime?
  completedAt     DateTime?
  pickedUpAt      DateTime?
  stripePaymentId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([jobNumber])
}

enum RepairStatus {
  SUBMITTED
  RECEIVED
  DIAGNOSING
  QUOTE_SENT
  APPROVED
  IN_PROGRESS
  COMPLETED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  RUSH
}

// ──────────────────────────────────────────────
// CONSIGNMENT
// ──────────────────────────────────────────────

model ConsignmentSubmission {
  id              String             @id @default(cuid())
  submissionNumber String            @unique
  userId          String
  itemDescription String
  category        String?
  condition       ItemCondition
  estimatedValue  Decimal?           @db.Decimal(10, 2)
  agreedPrice     Decimal?           @db.Decimal(10, 2)
  commissionRate  Decimal            @db.Decimal(5, 2) @default(30)
  status          ConsignmentStatus  @default(SUBMITTED)
  imageUrls       String[]
  notes           String?
  listedAt        DateTime?
  soldAt          DateTime?
  payoutAmount    Decimal?           @db.Decimal(10, 2)
  paidOutAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum ConsignmentStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  LISTED
  SOLD
  PAID_OUT
  EXPIRED
  RETURNED
}

// ──────────────────────────────────────────────
// PAWN TRANSACTIONS
// ──────────────────────────────────────────────

model PawnTransaction {
  id             String     @id @default(cuid())
  transactionNumber String  @unique
  userId         String
  itemDescription String
  category       String?
  condition      ItemCondition
  appraisedValue Decimal    @db.Decimal(10, 2)
  offerAmount    Decimal    @db.Decimal(10, 2)
  loanAmount     Decimal?   @db.Decimal(10, 2)
  interestRate   Decimal?   @db.Decimal(5, 2)
  status         PawnStatus @default(PENDING)
  type           PawnType
  imageUrls      String[]
  expiryDate     DateTime?
  redeemedAt     DateTime?
  forfeitedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum PawnStatus {
  PENDING
  APPRAISED
  OFFER_MADE
  ACCEPTED
  ACTIVE_LOAN
  REDEEMED
  FORFEITED
  SOLD
  REJECTED
}

enum PawnType {
  BUY
  PAWN_LOAN
  CONSIGNMENT_CONVERT
}

// ──────────────────────────────────────────────
// SUPPLIERS & SOURCING
// ──────────────────────────────────────────────

model Supplier {
  id          String       @id @default(cuid())
  name        String
  type        SupplierType
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  rating      Int?
  isActive    Boolean      @default(true)
  totalSpent  Decimal      @db.Decimal(12, 2) @default(0)
  totalItems  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[]
  purchases SupplierPurchase[]
}

enum SupplierType {
  THRIFT_STORE
  ESTATE_COMPANY
  LIQUIDATION_WHOLESALER
  AUCTION_HOUSE
  PRIVATE_SELLER
  BUSINESS_CLOSURE
}

model SupplierPurchase {
  id          String   @id @default(cuid())
  supplierId  String
  description String
  totalCost   Decimal  @db.Decimal(10, 2)
  itemCount   Int
  purchaseDate DateTime
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([purchaseDate])
}

// ──────────────────────────────────────────────
// WHOLESALE / LIQUIDATION DEALS
// ──────────────────────────────────────────────

model WholesaleDeal {
  id           String          @id @default(cuid())
  dealNumber   String          @unique
  buyerName    String
  buyerEmail   String?
  buyerPhone   String?
  itemCount    Int
  totalValue   Decimal         @db.Decimal(10, 2)
  agreedPrice  Decimal         @db.Decimal(10, 2)
  status       WholesaleStatus @default(DRAFT)
  notes        String?
  manifestUrl  String?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
}

enum WholesaleStatus {
  DRAFT
  PROPOSED
  NEGOTIATING
  ACCEPTED
  FULFILLED
  CANCELLED
}

// ──────────────────────────────────────────────
// REVIEWS & WISHLISTS
// ──────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  content   String?
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// REFERRALS & MARKETING
// ──────────────────────────────────────────────

model Referral {
  id           String         @id @default(cuid())
  code         String         @unique
  senderId     String
  receiverId   String?
  discountType DiscountType   @default(PERCENTAGE)
  discountValue Decimal       @db.Decimal(10, 2) @default(10)
  status       ReferralStatus @default(PENDING)
  redeemedAt   DateTime?
  createdAt    DateTime       @default(now())

  sender   User  @relation("ReferralSender", fields: [senderId], references: [id])
  receiver User? @relation("ReferralReceiver", fields: [receiverId], references: [id])

  @@index([code])
  @@index([senderId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReferralStatus {
  PENDING
  REDEEMED
  EXPIRED
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String?
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
}

// ──────────────────────────────────────────────
// BLOG / CONTENT
// ──────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  authorName  String
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ──────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  ORDER_UPDATE
  REPAIR_UPDATE
  CONSIGNMENT_UPDATE
  PAWN_UPDATE
  PROMOTION
  SYSTEM
}

// ──────────────────────────────────────────────
// ANALYTICS / FINANCIAL TRACKING
// ──────────────────────────────────────────────

model DailyMetrics {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  totalRevenue    Decimal  @db.Decimal(12, 2) @default(0)
  totalCost       Decimal  @db.Decimal(12, 2) @default(0)
  grossProfit     Decimal  @db.Decimal(12, 2) @default(0)
  orderCount      Int      @default(0)
  itemsSold       Int      @default(0)
  newCustomers    Int      @default(0)
  repairRevenue   Decimal  @db.Decimal(12, 2) @default(0)
  websiteVisits   Int      @default(0)
  conversionRate  Decimal  @db.Decimal(5, 4) @default(0)

  @@index([date])
}

model ChannelMetrics {
  id           String       @id @default(cuid())
  date         DateTime     @db.Date
  channel      SalesChannel
  revenue      Decimal      @db.Decimal(12, 2) @default(0)
  cost         Decimal      @db.Decimal(12, 2) @default(0)
  orderCount   Int          @default(0)
  itemsSold    Int          @default(0)
  avgOrderValue Decimal     @db.Decimal(10, 2) @default(0)

  @@unique([date, channel])
  @@index([date])
}
