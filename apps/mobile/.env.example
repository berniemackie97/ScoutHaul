# ── ScoutHaul Mobile Environment ──────────────────────────────────
#
# Copy to .env for defaults or .env.local for machine-specific overrides.
# .env.local is gitignored and takes precedence over .env.
#
# Build profiles (eas.json) override these for preview/production builds.
# On physical devices in dev mode, the app auto-resolves the API host
# from Expo's dev server (LAN IP), so localhost works for both web and device.
#
# ── Environment Switching ─────────────────────────────────────────
#
#   Development:  cp .env.example .env           (default, StubAuth)
#   Staging:      eas build --profile preview     (uses EAS preview env)
#   Production:   eas build --profile production  (uses EAS production env)

# ── API ───────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:5080

# ── Auth (Development only — StubAuth) ────────────────────────────
# These enable stub auth fallback. When a real login session exists, the
# app sends the Bearer token first. Remove these for production builds.
EXPO_PUBLIC_SCOUTHAUL_ORG_ID=9d3c0c44-218b-49d9-90bf-07b748610001
EXPO_PUBLIC_SCOUTHAUL_USER_ID=9d3c0c44-218b-49d9-90bf-07b748610002

# ── Auth (Supabase Auth) ──────────────────────────────────────────
# Supabase Auth handles cross-platform mobile/web sessions. ScoutHaul
# keeps teams, roles, permissions, and business data in its own API.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── EAS (set after running: eas init) ─────────────────────────────
# EAS_PROJECT_ID=
