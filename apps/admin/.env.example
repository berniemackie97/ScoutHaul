# Admin (operator) app configuration. Copy to .env and fill in.

# Supabase Auth — the OPERATOR project (same project the mobile app uses).
NEXT_PUBLIC_SUPABASE_URL="https://your-operator-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# ScoutHaul .NET API (operator backend).
NEXT_PUBLIC_API_BASE_URL="https://scouthaul-production.up.railway.app"
