# Public storefront identity.
# Sent by Next route handlers as X-HaulScout-Store. The API resolves the organization from this domain.
NEXT_PUBLIC_STORE_DOMAIN="overhaultrading.com"

# Public API origin used for catalog, cart, checkout, offers, and API-served photos.
NEXT_PUBLIC_API_BASE_URL="https://scouthaul-production.up.railway.app"

# Public customer auth config. Uses Supabase browser sessions for customer-owned offers/account pages.
NEXT_PUBLIC_SUPABASE_URL="https://your-customer-auth-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"

# Storefront payments are hosted by Stripe Checkout through the .NET API.
# Do not put Stripe secret keys or webhook secrets in Vercel storefront env vars.

# Transactional email (Resend). Used by the consignment/repair intake at /api/service-requests and by
# the first-dibs signup at /api/newsletter. Without RESEND_API_KEY both refuse the submission and say
# so rather than reporting a success they cannot deliver.
RESEND_API_KEY="re_xxx"
# Where submissions land, and who they come from. Until a domain is verified in Resend, sends must use
# the shared onboarding sender.
RESEND_TO="overhaultradingco@gmail.com"
RESEND_FROM="Overhaul Trading <onboarding@resend.dev>"
