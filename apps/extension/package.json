{
  "name": "@overhaul/extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "HaulScout Sync — keeps HaulScout in step with your marketplace accounts from the browser you already sell in.",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "postinstall": "wxt prepare",
    "type-check": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@overhaul/api-client": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.1.0",
    "wxt": "^0.21.4"
  }
}
