{
  "manifest_version": 3,
  "name": "HaulScout Listing Helper",
  "version": "0.1.0",
  "description": "Human-led listing helper for HaulScout. Prefills marketplace forms and captures listing links from pages you open — no bulk automation.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://scouthaul-production.up.railway.app/*",
    "http://localhost:5179/*",
    "https://*.ebay.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "HaulScout Listing Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.ebay.com/*"],
      "js": ["content-ebay.js"],
      "run_at": "document_idle"
    }
  ]
}
